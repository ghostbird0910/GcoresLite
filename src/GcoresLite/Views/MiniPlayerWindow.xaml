<Window x:Class="GcoresLite.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="机核播客 · 迷你"
        Width="380" Height="88"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="2" />
            <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10,8,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 容器背景只在没有封面时才出现，保证有封面时四角是真正透明的 -->
                <Border Width="44" Height="44" CornerRadius="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Cover}" Value="{x:Null}">
                                    <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <TextBlock Text="♪" FontSize="16" Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- 用 alpha 蒙版裁圆角：Clip 是硬裁剪会有锯齿，OpacityMask 才有平滑边缘 -->
                        <Image Source="{Binding Cover}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.OpacityMask>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Rectangle Width="44" Height="44"
                                                   RadiusX="10" RadiusY="10" Fill="Black" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Image.OpacityMask>
                        </Image>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock FontSize="10" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}">
                        <Run Text="{Binding PositionText, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding DurationText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MiniButton}" Content="⏮"
                            Command="{Binding PreviousCommand}" ToolTip="上一首" />
                    <Button Width="32" Command="{Binding TogglePlayCommand}"
                            ToolTip="播放 / 暂停">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MiniButton}">
                                <Setter Property="Content" Value="▶" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="FontSize" Value="13" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Content" Value="❚❚" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource MiniButton}" Content="⏭"
                            Command="{Binding NextCommand}" ToolTip="下一首" />
                    <Button Style="{StaticResource MiniButton}" Content="⤢" FontSize="13"
                            Click="Restore_Click" ToolTip="回到主窗口" />
                    <Button Style="{StaticResource MiniButton}" Content="✕" FontSize="10"
                            Click="Close_Click" ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <ProgressBar Grid.Row="1" Style="{StaticResource ThinProgress}"
                         Minimum="0" Maximum="{Binding DurationSeconds}"
                         Value="{Binding PositionSeconds}" Margin="1,0,1,1" />
        </Grid>
    </Border>
</Window>
